generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  citizen
  volunteer
  ally_admin
  ally_staff
  admin
}

enum VolunteerStatus {
  pending
  approved
  rejected
  inactive
}

enum AuthProviderType {
  google
  facebook
}

enum Species {
  dog
  cat
}

enum Size {
  small
  medium
  large
}

enum Condition {
  injured
  malnourished
  sick
  stable
  lost
  aggressive
}

enum Urgency {
  low
  medium
  high
  critical
}

enum ReportStatus {
  active
  in_progress
  rescued
  in_treatment
  recovering
  looking_for_foster
  in_foster
  looking_for_adoption
  adopted
  closed
  duplicate
  not_found
  deceased
}

enum ActionType {
  created
  sighting_added
  accepted
  on_the_way
  sheltered
  sent_to_vet
  record_created
  status_changed
  resource_offered
  resource_delivered
  donation_made
  donation_approved
  foster_assigned
  adopted
  flagged
  note
}

enum RescueStatus {
  accepted
  on_the_way
  arrived
  completed
  cancelled
}

enum OrgType {
  veterinary
  shelter
  ngo
  educational
}

enum RoleInOrg {
  admin
  veterinarian
  assistant
}

enum AnimalGender {
  male
  female
  unknown
}

enum AnimalStatus {
  in_treatment
  recovering
  looking_for_foster
  in_foster
  looking_for_adoption
  adopted
  deceased
}

enum RecordType {
  checkup
  surgery
  vaccination
  medication
  lab
  imaging
  other
}

enum ResourceType {
  money
  food
  transport
  foster
  medical_service
  supplies
  other
}

enum ResourceStatus {
  offered
  accepted
  delivered
  cancelled
}

enum DonationStatus {
  pending
  approved
  rejected
}

enum EventCategory {
  sterilization
  vaccination
  grooming
  donation
  adoption
  talk
  other
}

enum AchievementCategory {
  reporter
  volunteer
  donor
  foster
  social
  special
}

enum RequirementType {
  reports_count
  rescues_count
  donations_count
  foster_count
  resources_count
  forum_count
  points
  special
}

enum AchievementTier {
  bronze
  silver
  gold
  special
}

enum ReputationReason {
  report
  report_validated
  rescue
  foster
  donation
  forum_helpful
  penalty
  other
}

enum FosterStatus {
  proposed
  active
  ended
}

enum AdoptionStatus {
  pending
  approved
  rejected
  withdrawn
}

enum MatchStatus {
  suggested
  confirmed
  dismissed
}

enum FlagReason {
  spam
  fake
  inappropriate
  duplicate
  dangerous
  other
}

enum FlagStatus {
  open
  reviewed
  dismissed
  actioned
}

enum ForumCategory {
  health
  nutrition
  training
  legal
  general
}

enum NotifType {
  rescue_alert
  status_change
  achievement
  event_reminder
  closure
  resource
  lost_match
  system
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id                       String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String                                 @unique @db.VarChar(255)
  name                     String                                 @db.VarChar(150)
  phone                    String?                                @db.VarChar(20)
  passwordHash             String?                                @map("password_hash") @db.VarChar(255)
  avatarUrl                String?                                @map("avatar_url")
  avatarPublicId           String?                                @map("avatar_public_id") @db.VarChar(255)
  role                     Role                                   @default(citizen)
  volunteerStatus          VolunteerStatus?                       @map("volunteer_status")
  volunteerRejectionReason String?                                @map("volunteer_rejection_reason") @db.VarChar(500)
  ineFrontUrl              String?                                @map("ine_front_url")
  ineBackUrl               String?                                @map("ine_back_url")
  selfieUrl                String?                                @map("selfie_url")
  isFoster                 Boolean                                @default(false) @map("is_foster")
  fosterCapacity           Int?                                   @map("foster_capacity")
  isActive                 Boolean                                @default(true) @map("is_active")
  isAvailable              Boolean                                @default(false) @map("is_available")
  searchRadiusKm           Int                                    @default(5) @map("search_radius_km")
  lastLocation             Unsupported("geography(Point, 4326)")? @map("last_location")
  lastLocationAt           DateTime?                              @map("last_location_at") @db.Timestamptz
  level                    Int                                    @default(1)
  experiencePoints         Int                                    @default(0) @map("experience_points")
  reputationScore          Int                                    @default(0) @map("reputation_score")
  notifPrefs               Json?                                  @map("notif_prefs")
  volunteerPrefs           Json?                                  @map("volunteer_prefs")
  createdAt                DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                               @default(now()) @map("updated_at") @db.Timestamptz
  lastLogin                DateTime?                              @map("last_login") @db.Timestamptz

  // Relaciones
  authProviders        AuthProvider[]
  avatars              UserAvatar[]
  reports              Report[]               @relation("ReportUser")
  assignedReports      Report[]               @relation("ReportVolunteer")
  reportPhotos         ReportPhoto[]          @relation("ReportPhotoUploader")
  statusHistory        ReportStatusHistory[]  @relation("StatusHistoryChanger")
  caseActions          CaseAction[]           @relation("CaseActionActor")
  rescueAssignments    RescueAssignment[]     @relation("RescueVolunteer")
  orgEmployees         OrganizationEmployee[]
  animalAdoptions      AnimalProfile[]        @relation("AnimalAdopter")
  fosteredAnimals      AnimalProfile[]        @relation("AnimalFoster")
  medicalRecords       MedicalRecord[]        @relation("MedicalVeterinarian")
  vaccinations         Vaccination[]          @relation("VaccineVeterinarian")
  resourcesOffered     Resource[]             @relation("ResourceProvider")
  resourcesAccepted    Resource[]             @relation("ResourceAccepter")
  donationsMade        Donation[]             @relation("DonationUser")
  donationsApproved    Donation[]             @relation("DonationApprover")
  eventReminders       EventReminder[]
  achievements         UserAchievement[]
  reputationEvents     ReputationEvent[]
  fosterAssignments    FosterAssignment[]     @relation("FosterUser")
  adoptionApplications AdoptionApplication[]  @relation("AdoptionApplicant")
  adoptionsReviewed    AdoptionApplication[]  @relation("AdoptionReviewer")
  lostPets             LostPet[]              @relation("LostPetOwner")
  reportFlags          ReportFlag[]           @relation("FlaggedByUser")
  flagsReviewed        ReportFlag[]           @relation("FlagReviewer")
  forumPosts           ForumPost[]
  forumReplies         ForumReply[]
  forumVotes           ForumVote[]
  forumPostFlags       ForumPostFlag[]        @relation("ForumPostFlaggedByUser")
  forumFlagsReviewed   ForumPostFlag[]        @relation("ForumPostFlagReviewer")
  forumReplyFlags      ForumReplyFlag[]       @relation("ForumReplyFlaggedByUser")
  forumReplyFlagsRev   ForumReplyFlag[]       @relation("ForumReplyFlagReviewer")
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  discountCodes        DiscountCode[]
  auditLogs            AuditLog[]
  followedAnimals      AnimalFollower[]
  followedReports      ReportFollower[]
  needContributions    NeedContribution[]
  reportAdoptionRequests ReportAdoptionRequest[] @relation("ReportAdoptionApplicant")

  @@map("users")
}

model AuthProvider {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  provider   AuthProviderType
  providerId String           @map("provider_id") @db.VarChar(255)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("auth_providers")
}

model UserAvatar {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  avatarUrl String   @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("user_avatars")
}

model Report {
  id               String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                                 @map("user_id") @db.Uuid
  species          Species
  speciesVerified  Boolean                                @default(false) @map("species_verified")
  primaryColor     String                                 @map("primary_color") @db.VarChar(50)
  secondaryColor   String?                                @map("secondary_color") @db.VarChar(50)
  size             Size
  condition        Condition
  urgency          Urgency                                @default(medium)
  isMoving         Boolean?                               @map("is_moving")
  isAggressive     Boolean?                               @map("is_aggressive")
  hasCollar        Boolean?                               @map("has_collar")
  description      String
  location         Unsupported("geography(Point, 4326)")?
  address          String?                                @db.VarChar(255)
  colonyId         String?                                @map("colony_id") @db.VarChar(50)
  aiValidated      Boolean                                @default(false) @map("ai_validated")
  aiConfidence     Decimal?                               @map("ai_confidence") @db.Decimal(5, 2)
  aiSpecies        String?                                @map("ai_species") @db.VarChar(10)
  status           ReportStatus                           @default(active)
  volunteerId      String?                                @map("volunteer_id") @db.Uuid
  destinationOrgId String?                                @map("destination_org_id") @db.Uuid
  isDuplicateOf    String?                                @map("is_duplicate_of") @db.Uuid
  seenCount        Int                                    @default(1) @map("seen_count")
  lastSeenAt       DateTime                               @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt        DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                               @default(now()) @map("updated_at") @db.Timestamptz
  closedAt         DateTime?                              @map("closed_at") @db.Timestamptz

  user             User                  @relation("ReportUser", fields: [userId], references: [id])
  volunteer        User?                 @relation("ReportVolunteer", fields: [volunteerId], references: [id])
  destinationOrg   Organization?         @relation("ReportDestination", fields: [destinationOrgId], references: [id])
  originalReport   Report?               @relation("ReportDuplicate", fields: [isDuplicateOf], references: [id])
  duplicateReports Report[]              @relation("ReportDuplicate")
  colony           Colony?               @relation(fields: [colonyId], references: [id])
  animalProfile    AnimalProfile?
  photos           ReportPhoto[]
  statusHistory    ReportStatusHistory[]
  caseActions      CaseAction[]
  rescues          RescueAssignment[]
  resources        Resource[]
  lostPet          LostPet?
  lostMatches      LostPetMatch[]
  flags               ReportFlag[]
  followers           ReportFollower[]
  adoptionRequests    ReportAdoptionRequest[]

  @@index([status])
  @@map("reports")
}

model ReportAdoptionRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  message     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  report    Report @relation(fields: [reportId], references: [id])
  applicant User   @relation("ReportAdoptionApplicant", fields: [applicantId], references: [id])

  @@map("report_adoption_requests")
}

model ReportPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  url        String
  publicId   String   @map("public_id") @db.VarChar(255)
  orderIndex Int      @default(0) @map("order_index")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader User   @relation("ReportPhotoUploader", fields: [uploadedBy], references: [id])

  @@map("report_photos")
}

model ReportStatusHistory {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String        @map("report_id") @db.Uuid
  fromStatus ReportStatus? @map("from_status")
  toStatus   ReportStatus  @map("to_status")
  changedBy  String        @map("changed_by") @db.Uuid
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  report  Report @relation(fields: [reportId], references: [id])
  changer User   @relation("StatusHistoryChanger", fields: [changedBy], references: [id])

  @@map("report_status_history")
}

model CaseAction {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String?    @map("report_id") @db.Uuid
  animalId    String?    @map("animal_id") @db.Uuid
  actorId     String?    @map("actor_id") @db.Uuid
  actionType  ActionType @map("action_type")
  description String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  report Report?        @relation(fields: [reportId], references: [id])
  animal AnimalProfile? @relation(fields: [animalId], references: [id])
  actor  User?          @relation("CaseActionActor", fields: [actorId], references: [id])

  @@map("case_actions")
}

model RescueAssignment {
  id              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId        String                                 @map("report_id") @db.Uuid
  volunteerId     String                                 @map("volunteer_id") @db.Uuid
  status          RescueStatus                           @default(accepted)
  acceptedAt      DateTime                               @default(now()) @map("accepted_at") @db.Timestamptz
  etaMinutes      Int?                                   @map("eta_minutes")
  startLocation   Unsupported("geography(Point, 4326)")? @map("start_location")
  currentLocation Unsupported("geography(Point, 4326)")? @map("current_location")
  lastLocationAt  DateTime?                              @map("last_location_at") @db.Timestamptz
  completedAt     DateTime?                              @map("completed_at") @db.Timestamptz
  cancelledReason String?                                @map("cancelled_reason")

  report    Report @relation(fields: [reportId], references: [id])
  volunteer User   @relation("RescueVolunteer", fields: [volunteerId], references: [id])

  @@index([volunteerId, status])
  @@map("rescue_assignments")
}

model Organization {
  id              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String                                 @db.VarChar(200)
  description     String?
  logoUrl         String?                                @map("logo_url")
  logoPublicId    String?                                @map("logo_public_id") @db.VarChar(255)
  coverUrl        String?                                @map("cover_url")
  coverPublicId   String?                                @map("cover_public_id") @db.VarChar(255)
  slogan          String?                                @db.VarChar(255)
  address         String?                                @db.VarChar(255)
  zipCode         String?                                @map("zip_code") @db.VarChar(10)
  phone           String?                                @db.VarChar(20)
  whatsapp        String?                                @db.VarChar(20)
  location        Unsupported("geography(Point, 4326)")?
  website         String?                                @db.VarChar(255)
  schedule        Json?
  promo           String?                                @db.VarChar(500)
  orgType         OrgType                                @map("org_type")
  isVerified      Boolean                                @default(false) @map("is_verified")
  isApproved      Boolean                                @default(false) @map("is_approved")
  bankName        String?                                @map("bank_name") @db.VarChar(100)
  clabe           String?                                @db.VarChar(18)
  holderName      String?                                @map("holder_name") @db.VarChar(200)
  isActive        Boolean                                @default(true) @map("is_active")
  rejectionReason String?                                @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                               @default(now()) @map("updated_at") @db.Timestamptz

  employees        OrganizationEmployee[]
  events           Event[]
  discountCodes    DiscountCode[]
  animals          AnimalProfile[]        @relation("AnimalOrganization")
  reportsDestined  Report[]               @relation("ReportDestination")
  resourcesOffered Resource[]             @relation("ResourceOrganization")
  needs            Need[]

  @@map("organizations")
}

model OrganizationEmployee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleInOrg      RoleInOrg @map("role_in_org")
  isVerified     Boolean   @default(false) @map("is_verified")
  invitedEmail   String?   @map("invited_email") @db.VarChar(255)
  bio            String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_employees")
}

model AnimalProfile {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId        String?       @unique @map("report_id") @db.Uuid
  organizationId  String?       @map("organization_id") @db.Uuid
  name            String        @db.VarChar(100)
  species         Species
  breed           String?       @db.VarChar(100)
  ageEstimation   String?       @map("age_estimation") @db.VarChar(50)
  weightKg        Decimal?      @map("weight_kg") @db.Decimal(5, 2)
  color           String?       @db.VarChar(100)
  gender          AnimalGender?
  isNeutered      Boolean       @default(false) @map("is_neutered")
  isVaccinated    Boolean       @default(false) @map("is_vaccinated")
  isDewormed      Boolean       @default(false) @map("is_dewormed")
  microchipId     String?       @map("microchip_id") @db.VarChar(50)
  story           String?
  status          AnimalStatus
  diagnosis       String?
  treatment       String?
  totalCostNeeded Decimal       @default(0) @map("total_cost_needed") @db.Decimal(10, 2)
  totalRaised     Decimal       @default(0) @map("total_raised") @db.Decimal(10, 2)
  currentFosterId String?       @map("current_foster_id") @db.Uuid
  adoptedByUserId String?       @map("adopted_by_user_id") @db.Uuid
  adoptedAt       DateTime?     @map("adopted_at") @db.Timestamptz
  deceasedAt      DateTime?     @map("deceased_at") @db.Timestamptz
  deceasedNotes   String?       @map("deceased_notes")
  isPublic        Boolean       @default(true) @map("is_public")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  report               Report?               @relation(fields: [reportId], references: [id])
  organization         Organization?         @relation("AnimalOrganization", fields: [organizationId], references: [id])
  currentFoster        User?                 @relation("AnimalFoster", fields: [currentFosterId], references: [id])
  adopter              User?                 @relation("AnimalAdopter", fields: [adoptedByUserId], references: [id])
  photos               AnimalPhoto[]
  medicalRecords       MedicalRecord[]
  vaccinations         Vaccination[]
  resources            Resource[]
  donations            Donation[]
  caseActions          CaseAction[]
  fosterAssignments    FosterAssignment[]
  adoptionApplications AdoptionApplication[]
  timeline             AnimalTimelineEvent[]
  followers            AnimalFollower[]

  @@map("animal_profiles")
}

model AnimalPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId   String   @map("animal_id") @db.Uuid
  url        String
  publicId   String   @map("public_id") @db.VarChar(255)
  caption    String?  @db.VarChar(200)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  animal AnimalProfile @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("animal_photos")
}

model AnimalTimelineEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId    String   @map("animal_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?
  type        String   @db.VarChar(50)
  date        DateTime @map("date") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  animal AnimalProfile @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("animal_timeline_events")
}

model MedicalRecord {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId       String     @map("animal_id") @db.Uuid
  veterinarianId String     @map("veterinarian_id") @db.Uuid
  recordType     RecordType @map("record_type")
  description    String
  diagnosis      String?
  prescription   String?
  cost           Decimal    @default(0) @db.Decimal(10, 2)
  photoUrls      Json?      @map("photo_urls")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  animal       AnimalProfile @relation(fields: [animalId], references: [id])
  veterinarian User          @relation("MedicalVeterinarian", fields: [veterinarianId], references: [id])

  @@map("medical_records")
}

model Vaccination {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId       String    @map("animal_id") @db.Uuid
  vaccineName    String    @map("vaccine_name") @db.VarChar(100)
  appliedDate    DateTime  @map("applied_date") @db.Date
  nextDueDate    DateTime? @map("next_due_date") @db.Date
  veterinarianId String    @map("veterinarian_id") @db.Uuid
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  animal       AnimalProfile @relation(fields: [animalId], references: [id])
  veterinarian User          @relation("VaccineVeterinarian", fields: [veterinarianId], references: [id])

  @@map("vaccinations")
}

model Resource {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId     String         @map("provider_id") @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  reportId       String?        @map("report_id") @db.Uuid
  animalId       String?        @map("animal_id") @db.Uuid
  resourceType   ResourceType   @map("resource_type")
  title          String         @db.VarChar(150)
  description    String?
  quantity       String?        @db.VarChar(100)
  estimatedValue Decimal?       @map("estimated_value") @db.Decimal(10, 2)
  status         ResourceStatus @default(offered)
  acceptedBy     String?        @map("accepted_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz

  provider     User           @relation("ResourceProvider", fields: [providerId], references: [id])
  organization Organization?  @relation("ResourceOrganization", fields: [organizationId], references: [id])
  report       Report?        @relation(fields: [reportId], references: [id])
  animal       AnimalProfile? @relation(fields: [animalId], references: [id])
  accepter     User?          @relation("ResourceAccepter", fields: [acceptedBy], references: [id])

  @@map("resources")
}

model Donation {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  animalId     String         @map("animal_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  type         String         @default("money") @db.VarChar(50) // "money" or "items"
  items        String? // Description of items if type is "items"
  amount       Decimal        @db.Decimal(10, 2)
  currency     String         @default("MXN") @db.VarChar(3)
  status       DonationStatus @default(pending)
  approvedBy   String?        @map("approved_by") @db.Uuid
  approvedAt   DateTime?      @map("approved_at") @db.Timestamptz
  rejectReason String?        @map("reject_reason")
  isAnonymous  Boolean        @default(false) @map("is_anonymous")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  animal        AnimalProfile  @relation(fields: [animalId], references: [id])
